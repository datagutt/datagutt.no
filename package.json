{
  "name": "datagutt",
  "version": "0.1.0",
  "private": true,
  "license": "GPL-3.0-or-later",
  "scripts": {
    "dev": "next dev",
    "build": "pnpm assets && next build",
    "start": "next start",
    "lint": "eslint . --ext .ts,.tsx,.js,.mjs",
    "format": "prettier '**/*.{cjs,mjs,ts,tsx,md,json}' --ignore-path .gitignore --ignore-path .prettierignore --ignore-unknown --no-error-on-unmatched-pattern --write",
    "format:check": "prettier '**/*.{cjs,mjs,ts,tsx,md,json}' --ignore-path .gitignore --ignore-path .prettierignore --ignore-unknown --no-error-on-unmatched-pattern --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "game:dev": "pnpm assets && node scripts/game-dev.mjs",
    "assets": "node scripts/assets/fetch.mjs && node scripts/assets/build.mjs",
    "world:gen": "node scripts/world/gen.mjs",
    "world:render": "node scripts/world/gen.mjs --render",
    "world:check": "node scripts/world/gen.mjs --check",
    "world:catalog": "node scripts/world/catalog.mjs",
    "world:snow": "node scripts/world/snow-drafts.mjs",
    "characters:review": "node scripts/assets/characters-review.mjs"
  },
  "dependencies": {
    "@spissvinkel/simplex-noise": "^1.0.1",
    "@tailwindcss/typography": "^0.5.19",
    "@vercel/functions": "^3.7.3",
    "babel-plugin-react-compiler": "1.0.0",
    "critters": "^0.0.25",
    "geist": "^1.7.0",
    "gsap": "^3.13.0",
    "inkjs": "^2.4.0",
    "next": "16.3.6",
    "next-themes": "^0.2.1",
    "node-html-parser": "^7.0.2",
    "phaser": "^4.2.1",
    "react": "19.3.0",
    "react-activity-calendar": "^3.1.1",
    "react-dom": "19.3.0",
    "tailwindcss-animate": "^1.0.7",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@builder.io/partytown": "^0.10.3",
    "@playwright/test": "^1.63",
    "@types/node": "^24.13.6",
    "@types/pngjs": "^6.0.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "^8.18.1",
    "autoprefixer": "^10.4.22",
    "esbuild": "^0.28.2",
    "eslint": "^8.57.1",
    "eslint-config-next": "15.2.2",
    "opentype.js": "^2.0.0",
    "pngjs": "^7",
    "postcss": "^8.5.6",
    "prettier": "^3.7.4",
    "prettier-plugin-tailwindcss": "^0.5.14",
    "sharp": "^0.35.4",
    "tailwindcss": "^3.4.18",
    "typescript": "^5.9.3",
    "vitest": "^5",
    "wawoff2": "^2.0.1"
  },
  "packageManager": "pnpm@9.5.0+sha512.140036830124618d624a2187b50d04289d5a087f326c9edfc0ccd733d76c4f52c3a313d4fc148794a2a9d81553016004e6742e8cf850670268a7387fc220c903"
}
