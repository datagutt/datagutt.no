{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"propertyNames": {
		"type": "string",
		"pattern": "^[a-zA-Z0-9_-]+$"
	},
	"additionalProperties": {
		"type": "object",
		"properties": {
			"name": {
				"type": "string",
				"minLength": 1
			},
			"place": {
				"type": "string",
				"minLength": 1
			},
			"personality": {
				"type": "string"
			},
			"presents": {
				"type": "string"
			},
			"voice": {
				"type": "object",
				"properties": {
					"wave": {
						"type": "string",
						"enum": [
							"sine",
							"square",
							"sawtooth",
							"triangle"
						]
					},
					"pitch": {
						"type": "number",
						"exclusiveMinimum": 0
					},
					"variance": {
						"type": "number",
						"minimum": 0,
						"maximum": 1
					},
					"volume": {
						"type": "number",
						"minimum": 0,
						"maximum": 1
					},
					"every": {
						"type": "integer",
						"exclusiveMinimum": 0,
						"maximum": 9007199254740991
					}
				},
				"required": [
					"wave",
					"pitch",
					"variance",
					"volume",
					"every"
				]
			}
		},
		"required": [
			"name",
			"voice"
		]
	},
	"properties": {
		"$schema": {
			"type": "string"
		}
	}
}
