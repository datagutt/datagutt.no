{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"properties": {
		"$schema": {
			"type": "string"
		},
		"tracks": {
			"type": "object",
			"propertyNames": {
				"type": "string",
				"pattern": "^[a-zA-Z0-9_-]+$"
			},
			"additionalProperties": {
				"type": "object",
				"properties": {
					"file": {
						"type": "string",
						"minLength": 1
					}
				},
				"required": [
					"file"
				]
			}
		},
		"playlist": {
			"type": "object",
			"properties": {
				"title": {
					"type": "string",
					"pattern": "^[a-zA-Z0-9_-]+$"
				},
				"credits": {
					"type": "string",
					"pattern": "^[a-zA-Z0-9_-]+$"
				},
				"outdoors": {
					"type": "object",
					"properties": {
						"day": {
							"type": "string",
							"pattern": "^[a-zA-Z0-9_-]+$"
						},
						"night": {
							"type": "string",
							"pattern": "^[a-zA-Z0-9_-]+$"
						},
						"winter": {
							"type": "string",
							"pattern": "^[a-zA-Z0-9_-]+$"
						}
					},
					"required": [
						"day",
						"night",
						"winter"
					]
				},
				"indoors": {
					"type": "object",
					"properties": {
						"default": {
							"type": "string",
							"pattern": "^[a-zA-Z0-9_-]+$"
						},
						"maps": {
							"default": {},
							"type": "object",
							"propertyNames": {
								"type": "string",
								"pattern": "^[a-zA-Z0-9_-]+$"
							},
							"additionalProperties": {
								"type": "string",
								"pattern": "^[a-zA-Z0-9_-]+$"
							}
						}
					},
					"required": [
						"default"
					]
				}
			},
			"required": [
				"title",
				"credits",
				"outdoors",
				"indoors"
			]
		}
	},
	"required": [
		"tracks",
		"playlist"
	]
}
