{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"properties": {
		"$schema": {
			"type": "string"
		},
		"list": {
			"type": "array",
			"items": {
				"type": "object",
				"properties": {
					"id": {
						"type": "string",
						"pattern": "^[a-zA-Z0-9_-]+$"
					},
					"name": {
						"type": "string",
						"minLength": 1
					},
					"how": {
						"type": "string",
						"minLength": 1
					}
				},
				"required": [
					"id",
					"name",
					"how"
				]
			}
		}
	},
	"required": [
		"list"
	]
}
