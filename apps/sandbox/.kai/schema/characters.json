{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"propertyNames": {
		"type": "string",
		"pattern": "^[a-zA-Z0-9_-]+$"
	},
	"additionalProperties": {
		"type": "object",
		"properties": {
			"description": {
				"type": "string"
			},
			"layers": {
				"minItems": 1,
				"type": "array",
				"items": {
					"anyOf": [
						{
							"type": "string",
							"minLength": 1
						},
						{
							"type": "object",
							"properties": {
								"file": {
									"type": "string",
									"minLength": 1
								},
								"portrait": {
									"type": "string",
									"minLength": 1
								}
							},
							"required": [
								"file",
								"portrait"
							]
						}
					]
				}
			},
			"recolor": {
				"type": "object",
				"propertyNames": {
					"type": "string",
					"pattern": "^[0-9a-f]{6}([0-9a-f]{2})?$"
				},
				"additionalProperties": {
					"type": "string",
					"pattern": "^[0-9a-f]{6}([0-9a-f]{2})?$"
				}
			},
			"placeholder": {
				"type": "string",
				"pattern": "^[0-9a-f]{6}([0-9a-f]{2})?$"
			},
			"portrait": {
				"anyOf": [
					{
						"type": "array",
						"items": {
							"type": "string",
							"minLength": 1
						}
					},
					{
						"type": "boolean",
						"const": false
					}
				]
			}
		},
		"required": [
			"layers",
			"placeholder"
		]
	},
	"properties": {
		"$schema": {
			"type": "string"
		}
	}
}
