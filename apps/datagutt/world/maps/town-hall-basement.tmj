            {
              "name": "text",
              "type": "string",
              "value": "* An escalator. The council spent the IT budget for 2019 on it. It only goes up."
            }
          ]
        },
        {
          "id": 16,
          "name": "",
          "type": "sign",
          "x": 256,
          "y": 48,
