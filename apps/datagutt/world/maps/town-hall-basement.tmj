          "height": 16,
          "rotation": 0,
          "visible": true,
          "properties": [
            {
              "name": "text",
              "type": "string",
              "value": "* The printers. One of them says PC LOAD LETTER. Nobody knows what that means."
            }
          ]
        },
        {
          "id": 17,
          "name": "",
          "type": "sign",
          "x": 320,
