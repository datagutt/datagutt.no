{
  "name": "datagutt",
  "version": "0.1.0",
  "private": true,
  "license": "GPL-3.0-or-later",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "game:dev": "node scripts/game-dev.mjs",
    "assets": "node scripts/assets/fetch.mjs && node scripts/assets/build.mjs",
    "world:gen": "node scripts/world/gen.mjs",
    "world:render": "node scripts/world/gen.mjs --render",
    "world:check": "node scripts/world/gen.mjs --check",
    "world:catalog": "node scripts/world/catalog.mjs",
    "world:snow": "node scripts/world/snow-drafts.mjs",
    "characters:review": "node scripts/assets/characters-review.mjs",
    "test:e2e:all": "E2E_ALL_BROWSERS=1 playwright test --workers=2",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@datagutt/kai": "workspace:*",
    "@datagutt/kai-arcade": "workspace:*",
    "@datagutt/kai-live": "workspace:*",
    "@datagutt/kai-net": "workspace:*",
    "@vercel/functions": "^3.7.3",
    "babel-plugin-react-compiler": "1.0.0",
    "critters": "^0.0.25",
    "geist": "^1.7.0",
    "inkjs": "^2.4.0",
    "next": "16.3.6",
    "node-html-parser": "^7.0.2",
    "phaser": "^4.2.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@builder.io/partytown": "^0.10.3",
    "@datagutt/kai-eslint-config": "workspace:*",
    "@datagutt/kai-tsconfig": "workspace:*",
    "@datagutt/kai-vitest-config": "workspace:*",
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@playwright/test": "^1.63",
    "@types/node": "^24.13.6",
    "@types/pngjs": "^6.0.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vercel/config": "^0.7.2",
    "autoprefixer": "^10.4.22",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "opentype.js": "^2.0.0",
    "pngjs": "^7",
    "postcss": "^8.5.6",
    "sharp": "^0.35.4",
    "tailwindcss": "^3.4.18",
    "typescript": "^5.9.3",
    "vitest": "^5",
    "wawoff2": "^2.0.1"
  }
}
