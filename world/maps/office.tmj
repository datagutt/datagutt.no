          "id": 31,
          "name": "",
          "type": "sign",
          "x": 64,
          "y": 32,
          "width": 16,
          "height": 16,
          "rotation": 0,
          "visible": true,
          "properties": [
            {
              "name": "text",
              "type": "string",
              "value": "* A whiteboard: \"Loan offers compared this week\". The line goes up and to the right. Someone drew a rocket at the end."
            }
          ]
        },
        {
          "id": 32,
          "name": "",
          "type": "sign",
          "x": 112,
          "y": 32,
          "width": 16,
          "height": 16,
          "rotation": 0,
          "visible": true,
          "properties": [
            {
              "name": "text",
              "type": "string",
              "value": "* A whiteboard full of boxes and arrows. In the corner: \"do NOT erase (Thomas)\"."
            }
          ]
        },
        {
          "id": 33,
          "name": "",
          "type": "sign",
          "x": 304,
          "y": 32,
          "width": 16,
          "height": 16,
          "rotation": 0,
          "visible": true,
          "properties": [
            {
              "name": "text",
              "type": "string",
              "value": "* A neon-lit poster of smiling pixel faces. Across the bottom: \"Ship it. Then ship it again.\""
            }
          ]
        },
        {
          "id": 34,
          "name": "",
          "type": "sign",
          "x": 368,
          "y": 32,
          "width": 16,
          "height": 16,
          "rotation": 0,
          "visible": true,
          "properties": [
            {
              "name": "text",
              "type": "string",
              "value": "* A pie chart. Most of the pie is labelled \"refinancing\". A small slice says \"cake\"."
            }
          ]
        },
        {
          "id": 35,
          "name": "",
          "type": "sign",
          "x": 544,
          "y": 48,
          "width": 16,
          "height": 16,
          "rotation": 0,
          "visible": true,
          "properties": [
            {
              "name": "text",
              "type": "string",
              "value": "* The vending machine sells one thing: energy drinks. Thomas asked for that."
            }
          ]
        },
        {
          "id": 36,
