        },
        {
          "id": 41,
          "name": "",
          "type": "sign",
          "x": 112,
          "y": 32,
          "width": 16,
          "height": 16,
          "rotation": 0,
          "visible": true,
          "properties": [
            {
              "name": "text",
              "type": "string",
              "value": "* A whiteboard full of boxes and arrows. In the corner: \"do NOT erase (Thomas)\"."
            }
          ]
        },
        {
          "id": 42,
          "name": "",
          "type": "sign",
          "x": 304,
          "y": 32,
          "width": 16,
          "height": 16,
          "rotation": 0,
          "visible": true,
          "properties": [
            {
              "name": "text",
              "type": "string",
              "value": "* A neon-lit poster of smiling pixel faces. Across the bottom: \"Ship it. Then ship it again.\""
            }
          ]
        },
        {
          "id": 43,
          "name": "",
          "type": "sign",
          "x": 368,
          "y": 32,
          "width": 16,
          "height": 16,
          "rotation": 0,
          "visible": true,
          "properties": [
            {
              "name": "text",
              "type": "string",
              "value": "* A pie chart. Most of the pie is labelled \"refinancing\". A small slice says \"cake\"."
            }
          ]
        },
        {
          "id": 44,
          "name": "",
          "type": "sign",
          "x": 544,
